# R Plot Service 配置文件
# 所有路径使用绝对路径

# ============================================
# 数据配置
# ============================================

# 数据目录的绝对路径（必须修改为服务器实际路径）
DATA_PATH=/Users/craft/Desktop/KIT-Server/data

# ============================================
# 服务配置
# ============================================

# Gateway 端口
GATEWAY_PORT=8080

# Nacos 端口
NACOS_PORT=8848
NACOS_GRPC_PORT=9848

# R 服务实例数量（默认 3，可根据服务器资源调整）
R_SERVICE_REPLICAS=3

# R 服务起始端口（实例端口为: 8001, 8002, 8003...）
R_SERVICE_START_PORT=8001

# ============================================
# 资源限制（生产环境建议配置）
# ============================================

# Nacos JVM 内存设置
NACOS_JVM_XMS=512m
NACOS_JVM_XMX=512m

# R 服务内存限制（每个实例）
R_SERVICE_MEMORY_LIMIT=2g
R_SERVICE_MEMORY_RESERVATION=1g

# Gateway 内存限制
GATEWAY_MEMORY_LIMIT=512m
GATEWAY_MEMORY_RESERVATION=256m

# ============================================
# 网络配置
# ============================================

# Docker 网络名称
NETWORK_NAME=r-plot-network

# ============================================
# 日志配置
# ============================================

# 日志目录
LOG_DIR=./logs

# 日志保留天数
LOG_RETENTION_DAYS=7

# ============================================
# 环境标识
# ============================================

# 环境类型: development, production
ENVIRONMENT=production

# 项目名称（用于容器命名）
PROJECT_NAME=r-plot-service
