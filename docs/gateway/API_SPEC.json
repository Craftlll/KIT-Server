{
    "openapi": "3.0.0",
    "info": {
        "title": "R Plot Service API",
        "description": "基于 Nacos 服务发现的 R 绘图服务 API，通过 Gateway 提供负载均衡和统一访问入口",
        "version": "1.2.0",
        "contact": {
            "name": "API Support"
        }
    },
    "servers": [
        {
            "url": "http://localhost:8080/api/v1",
            "description": "本地开发环境 (通过 Gateway)"
        }
    ],
    "paths": {
        "/health": {
            "get": {
                "summary": "健康检查",
                "description": "检查 Gateway 和后端 R 服务的健康状态",
                "tags": [
                    "系统"
                ],
                "responses": {
                    "200": {
                        "description": "服务健康",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "UP",
                                            "description": "服务状态"
                                        },
                                        "instances": {
                                            "type": "integer",
                                            "example": 3,
                                            "description": "可用的 R 服务实例数"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/datasets": {
            "get": {
                "summary": "获取数据集列表",
                "description": "获取所有可用的单细胞数据集",
                "tags": [
                    "数据集"
                ],
                "responses": {
                    "200": {
                        "description": "成功返回数据集列表",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "datasets": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "string",
                                                        "example": "NO1",
                                                        "description": "数据集 ID"
                                                    },
                                                    "name": {
                                                        "type": "string",
                                                        "example": "Dataset NO1",
                                                        "description": "数据集名称"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                },
                                "example": {
                                    "datasets": [
                                        {
                                            "id": "NO1",
                                            "name": "Dataset NO1"
                                        },
                                        {
                                            "id": "NO2",
                                            "name": "Dataset NO2"
                                        },
                                        {
                                            "id": "NO3",
                                            "name": "Dataset NO3"
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/genes/check": {
            "get": {
                "summary": "检查基因是否存在",
                "description": "检查指定基因在数据集中是否存在",
                "tags": [
                    "基因"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "NO1"
                        },
                        "description": "数据集 ID"
                    },
                    {
                        "name": "gene",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "GAPDH"
                        },
                        "description": "基因名称"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "基因存在",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "found": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "gene": {
                                            "type": "string",
                                            "example": "GAPDH",
                                            "description": "标准化的基因名称"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "数据集不存在",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Dataset ID not found"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "440": {
                        "description": "基因不存在",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Gene GAPDH not found"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/plots/all": {
            "get": {
                "summary": "获取所有图表",
                "description": "生成并返回指定基因的所有图表路径（包括基因特异性图表和基础图表）",
                "tags": [
                    "图表"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "NO1"
                        },
                        "description": "数据集 ID"
                    },
                    {
                        "name": "gene",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "GAPDH"
                        },
                        "description": "基因名称"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功生成图表",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "gene": {
                                            "type": "string",
                                            "example": "GAPDH",
                                            "description": "基因名称"
                                        },
                                        "gene_plots": {
                                            "type": "object",
                                            "description": "基因特异性图表的路径对象",
                                            "properties": {
                                                "feature": {
                                                    "type": "string",
                                                    "example": "/data/NO1/lite/cache/GAPDH/feature_plot.png"
                                                },
                                                "dot_withanno": {
                                                    "type": "string",
                                                    "example": "/data/NO1/lite/cache/GAPDH/dot_plot_withanno.png"
                                                },
                                                "dot_noanno": {
                                                    "type": "string",
                                                    "example": "/data/NO1/lite/cache/GAPDH/dot_plot_noanno.png"
                                                },
                                                "heat_withanno": {
                                                    "type": "string",
                                                    "example": "/data/NO1/lite/cache/GAPDH/heat_plot_withanno.png"
                                                },
                                                "heat_noanno": {
                                                    "type": "string",
                                                    "example": "/data/NO1/lite/cache/GAPDH/heat_plot_noanno.png"
                                                }
                                            }
                                        },
                                        "base_plots": {
                                            "type": "object",
                                            "description": "基础图表的路径对象",
                                            "properties": {
                                                "uas": {
                                                    "type": "string",
                                                    "example": "/data/NO1/lite/base/uas.png"
                                                },
                                                "ucd45": {
                                                    "type": "string",
                                                    "example": "/data/NO1/lite/base/ucd45.png"
                                                },
                                                "ucta_withanno": {
                                                    "type": "string",
                                                    "example": "/data/NO1/lite/base/ucta_withanno.png"
                                                },
                                                "ucta_noanno": {
                                                    "type": "string",
                                                    "example": "/data/NO1/lite/base/ucta_noanno.png"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "数据集不存在"
                    },
                    "440": {
                        "description": "基因不存在"
                    },
                    "500": {
                        "description": "图表生成失败"
                    }
                }
            }
        },
        "/plots/anno": {
            "get": {
                "summary": "获取带注释的图表",
                "description": "生成并返回指定基因的带注释(anno)图表路径。网关层会调用 /plots/all 接口，然后过滤出带 anno 的图像",
                "tags": [
                    "图表"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "NO1"
                        },
                        "description": "数据集 ID"
                    },
                    {
                        "name": "gene",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "GAPDH"
                        },
                        "description": "基因名称"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功生成图表",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "gene": {
                                            "type": "string",
                                            "example": "GAPDH",
                                            "description": "基因名称"
                                        },
                                        "gene_plots": {
                                            "type": "object",
                                            "description": "基因特异性带注释图表",
                                            "properties": {
                                                "dot_withanno": {
                                                    "type": "string",
                                                    "example": "/data/NO1/lite/cache/GAPDH/dot_plot_withanno.png"
                                                },
                                                "heat_withanno": {
                                                    "type": "string",
                                                    "example": "/data/NO1/lite/cache/GAPDH/heat_plot_withanno.png"
                                                }
                                            }
                                        },
                                        "base_plots": {
                                            "type": "object",
                                            "description": "基础带注释图表",
                                            "properties": {
                                                "ucta_withanno": {
                                                    "type": "string",
                                                    "example": "/data/NO1/lite/base/ucta_withanno.png"
                                                }
                                            }
                                        },
                                        "filter_type": {
                                            "type": "string",
                                            "example": "anno",
                                            "description": "过滤类型"
                                        },
                                        "description": {
                                            "type": "string",
                                            "example": "仅包含带注释(anno)的图像",
                                            "description": "过滤说明"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "数据集不存在"
                    },
                    "440": {
                        "description": "基因不存在"
                    },
                    "500": {
                        "description": "图表生成失败"
                    }
                }
            }
        },
        "/plots/noanno": {
            "get": {
                "summary": "获取不带注释的图表",
                "description": "生成并返回指定基因的不带注释(noanno)图表路径。网关层会调用 /plots/all 接口，然后过滤出不带 anno 的图像",
                "tags": [
                    "图表"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "NO1"
                        },
                        "description": "数据集 ID"
                    },
                    {
                        "name": "gene",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "GAPDH"
                        },
                        "description": "基因名称"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功生成图表",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "gene": {
                                            "type": "string",
                                            "example": "GAPDH",
                                            "description": "基因名称"
                                        },
                                        "gene_plots": {
                                            "type": "object",
                                            "description": "基因特异性不带注释图表",
                                            "properties": {
                                                "feature": {
                                                    "type": "string",
                                                    "example": "/data/NO1/lite/cache/GAPDH/feature_plot.png"
                                                },
                                                "dot_noanno": {
                                                    "type": "string",
                                                    "example": "/data/NO1/lite/cache/GAPDH/dot_plot_noanno.png"
                                                },
                                                "heat_noanno": {
                                                    "type": "string",
                                                    "example": "/data/NO1/lite/cache/GAPDH/heat_plot_noanno.png"
                                                }
                                            }
                                        },
                                        "base_plots": {
                                            "type": "object",
                                            "description": "基础不带注释图表",
                                            "properties": {
                                                "uas": {
                                                    "type": "string",
                                                    "example": "/data/NO1/lite/base/uas.png"
                                                },
                                                "ucd45": {
                                                    "type": "string",
                                                    "example": "/data/NO1/lite/base/ucd45.png"
                                                },
                                                "ucta_noanno": {
                                                    "type": "string",
                                                    "example": "/data/NO1/lite/base/ucta_noanno.png"
                                                }
                                            }
                                        },
                                        "filter_type": {
                                            "type": "string",
                                            "example": "noanno",
                                            "description": "过滤类型"
                                        },
                                        "description": {
                                            "type": "string",
                                            "example": "仅包含不带注释(noanno)的图像",
                                            "description": "过滤说明"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "数据集不存在"
                    },
                    "440": {
                        "description": "基因不存在"
                    },
                    "500": {
                        "description": "图表生成失败"
                    }
                }
            }
        },
        "/plots/types": {
            "get": {
                "summary": "获取可用图表类型",
                "description": "获取指定数据集支持的图表类型列表",
                "tags": [
                    "图表"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "NO1"
                        },
                        "description": "数据集 ID"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功返回图表类型",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "types": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            },
                                            "example": [
                                                "feature",
                                                "dot_anno",
                                                "heat_anno",
                                                "dot_cluster",
                                                "heat_cluster"
                                            ]
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "系统",
            "description": "系统健康检查和状态"
        },
        {
            "name": "数据集",
            "description": "数据集管理"
        },
        {
            "name": "基因",
            "description": "基因查询"
        },
        {
            "name": "图表",
            "description": "图表生成"
        }
    ]
}